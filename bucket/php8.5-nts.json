{
    "version": "8.5.11",
    "homepage": "https://www.php.net/downloads.php?os=windows&osvariant=windows-downloads&version=8.5",
    "description": "PHP 8.5 (non-thread-safe/NTS build) for Windows. Widely used open-source scripting language for web development.",
    "license": {
        "identifier": "PHP-3.01",
        "url": "https://www.php.net/license/"
    },
    "suggest": {
        "vcredist": "extras/vcredist2022"
    },
    "architecture": {
        "32bit": {
            "url": "https://downloads.php.net/~windows/releases/archives/php-8.5.11-nts-Win32-vs17-x86.zip",
            "hash": "c51955ba7e3b4cf61db3d32091a721b1cdd0230ecebdad164098df215a4da6c5"
        },
        "64bit": {
            "url": "https://downloads.php.net/~windows/releases/archives/php-8.5.11-nts-Win32-vs17-x64.zip",
            "hash": "0ea96e0d2b9b737a6036f05cf4e95c49313faa6d0f27bd97edb2742503f0c043"
        }
    },
    "post_install": "if($bucket) { . \"$(Find-BucketDirectory $bucket\\bin\\postinstall.ps1)\" -dir \"$dir\" }",
    "env_set": {
        "PHP_INI_SCAN_DIR": "$persist_dir;$dir\\conf.d;"
    },
    "bin": [
        "php.exe",
        "php-cgi.exe"
    ],
    "persist": "conf.d",
    "checkver": {
        "url": "https://www.php.net/releases/branches.php",
        "jsonpath": "$.[?(@.branch == '8.5')].latest"
    },
    "autoupdate": {
        "architecture": {
            "32bit": {
                "url": "https://downloads.php.net/~windows/releases/archives/php-$version-nts-Win32-vs17-x86.zip"
            },
            "64bit": {
                "url": "https://downloads.php.net/~windows/releases/archives/php-$version-nts-Win32-vs17-x64.zip"
            }
        },
        "hash": {
            "url": "https://downloads.php.net/~windows/releases/releases.json",
            "jsonpath": "$..[?(@.path == '$basename')].sha256"
        }
    }
}
