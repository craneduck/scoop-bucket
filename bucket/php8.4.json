{
    "version": "8.4.27",
    "homepage": "https://www.php.net/downloads.php?os=windows&osvariant=windows-downloads&version=8.4",
    "description": "PHP 8.4 (thread-safe/TS build) for Windows. Widely used open-source scripting language for web development.",
    "license": {
        "identifier": "PHP-3.01",
        "url": "https://www.php.net/license/"
    },
    "suggest": {
        "vcredist": "extras/vcredist2022"
    },
    "architecture": {
        "32bit": {
            "url": "https://downloads.php.net/~windows/releases/archives/php-8.4.27-Win32-vs17-x86.zip",
            "hash": "b1f02421a1f92e65930cdf6d5819138cd4ceb120740ef05968387fe72a3c6bda"
        },
        "64bit": {
            "url": "https://downloads.php.net/~windows/releases/archives/php-8.4.27-Win32-vs17-x64.zip",
            "hash": "7902fe891ff4b035d431fd429a2ec1df193ba1f6fedba425d861790465c64e6b"
        }
    },
    "post_install": "if($bucket) { . \"$(Find-BucketDirectory $bucket\\bin\\postinstall.ps1)\" -dir \"$dir\" }",
    "env_set": {
        "PHP_INI_SCAN_DIR": "$persist_dir;$dir\\conf.d;"
    },
    "bin": [
        "php.exe",
        "php-cgi.exe"
    ],
    "persist": "conf.d",
    "checkver": {
        "url": "https://www.php.net/releases/branches.php",
        "jsonpath": "$.[?(@.branch == '8.4')].latest"
    },
    "autoupdate": {
        "architecture": {
            "32bit": {
                "url": "https://downloads.php.net/~windows/releases/archives/php-$version-Win32-vs17-x86.zip"
            },
            "64bit": {
                "url": "https://downloads.php.net/~windows/releases/archives/php-$version-Win32-vs17-x64.zip"
            }
        },
        "hash": {
            "url": "https://downloads.php.net/~windows/releases/releases.json",
            "jsonpath": "$..[?(@.path == '$basename')].sha256"
        }
    }
}
