{
    "version": "8.3.35",
    "homepage": "https://www.php.net/downloads.php?os=windows&osvariant=windows-downloads&version=8.3",
    "description": "PHP 8.3 (thread-safe/TS build) for Windows. Widely used open-source scripting language for web development.",
    "license": {
        "identifier": "PHP-3.01",
        "url": "https://www.php.net/license/"
    },
    "suggest": {
        "vcredist": "extras/vcredist2022"
    },
    "architecture": {
        "32bit": {
            "url": "https://downloads.php.net/~windows/releases/archives/php-8.3.35-Win32-vs16-x86.zip",
            "hash": "b8f849ca02d271c6cc76bb814e6d3b1b4f3ee8ecce7b083bd6c963d500d7af13"
        },
        "64bit": {
            "url": "https://downloads.php.net/~windows/releases/archives/php-8.3.35-Win32-vs16-x64.zip",
            "hash": "b454bed828a74536125d8a96119eae8ffbb186b305759dd6cf8d9bb4b55968b1"
        }
    },
    "post_install": "if($bucket) { . \"$(Find-BucketDirectory $bucket\\bin\\postinstall.ps1)\" -dir \"$dir\" }",
    "env_set": {
        "PHP_INI_SCAN_DIR": "$persist_dir;$dir\\conf.d;"
    },
    "bin": [
        "php.exe",
        "php-cgi.exe"
    ],
    "persist": "conf.d",
    "checkver": {
        "url": "https://www.php.net/releases/branches.php",
        "jsonpath": "$.[?(@.branch == '8.3')].latest"
    },
    "autoupdate": {
        "architecture": {
            "32bit": {
                "url": "https://downloads.php.net/~windows/releases/archives/php-$version-Win32-vs16-x86.zip"
            },
            "64bit": {
                "url": "https://downloads.php.net/~windows/releases/archives/php-$version-Win32-vs16-x64.zip"
            }
        },
        "hash": {
            "url": "https://downloads.php.net/~windows/releases/releases.json",
            "jsonpath": "$..[?(@.path == '$basename')].sha256"
        }
    }
}
