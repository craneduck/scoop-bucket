{
    "version": "8.3.29",
    "homepage": "https://www.php.net/downloads.php?os=windows&osvariant=windows-downloads&version=8.3",
    "description": "PHP 8.3 (non-thread-safe/NTS build) for Windows. Widely used open-source scripting language for web development.",
    "license": {
        "identifier": "PHP-3.01",
        "url": "https://www.php.net/license/"
    },
    "suggest": {
        "vcredist": "extras/vcredist2022"
    },
    "architecture": {
        "32bit": {
            "url": "https://downloads.php.net/~windows/releases/archives/php-8.3.29-nts-Win32-vs16-x86.zip",
            "hash": "f53521705d6a7ec58932c79ddbbd9ee430b8c7e058fd3874e1a68c6694e535fe"
        },
        "64bit": {
            "url": "https://downloads.php.net/~windows/releases/archives/php-8.3.29-nts-Win32-vs16-x64.zip",
            "hash": "20bbc441b4b88c3c94e08bbaa75029c5f8dc8d9cba8a515381722239818e2557"
        }
    },
    "post_install": "if($bucket) { . \"$(Find-BucketDirectory $bucket\\bin\\postinstall.ps1)\" -dir \"$dir\" }",
    "env_set": {
        "PHP_INI_SCAN_DIR": "$persist_dir;$dir\\conf.d;"
    },
    "bin": [
        "php.exe",
        "php-cgi.exe"
    ],
    "persist": "conf.d",
    "checkver": {
        "url": "https://www.php.net/releases/branches.php",
        "jsonpath": "$.[?(@.branch == '8.3')].latest"
    },
    "autoupdate": {
        "architecture": {
            "32bit": {
                "url": "https://downloads.php.net/~windows/releases/archives/php-$version-nts-Win32-vs16-x86.zip"
            },
            "64bit": {
                "url": "https://downloads.php.net/~windows/releases/archives/php-$version-nts-Win32-vs16-x64.zip"
            }
        },
        "hash": {
            "url": "https://downloads.php.net/~windows/releases/releases.json",
            "jsonpath": "$..[?(@.path == '$basename')].sha256"
        }
    }
}
