{
    "version": "8.6.0",
    "homepage": "https://www.php.net/downloads.php?os=windows&osvariant=windows-downloads&version=8.6",
    "description": "PHP 8.6 (non-thread-safe/NTS build) for Windows. Widely used open-source scripting language for web development.",
    "license": {
        "identifier": "PHP-3.01",
        "url": "https://www.php.net/license/"
    },
    "suggest": {
        "vcredist": "extras/vcredist2022"
    },
    "architecture": {
        "32bit": {
            "url": "https://downloads.php.net/~windows/releases/archives/php-8.6.0-nts-Win32-vs18-x86.zip",
            "hash": "a3006c641c5684ac7a8178ff3df2f2994e864e2b0339b84eba928ae4a699459d"
        },
        "64bit": {
            "url": "https://downloads.php.net/~windows/releases/archives/php-8.6.0-nts-Win32-vs18-x64.zip",
            "hash": "d4783fffe1f4ab072600daff1622a7a2df936957a787a338c59e3dbd4d846d98"
        }
    },
    "post_install": "if($bucket) { . \"$(Find-BucketDirectory $bucket\\bin\\postinstall.ps1)\" -dir \"$dir\" }",
    "env_set": {
        "PHP_INI_SCAN_DIR": "$persist_dir;$dir\\conf.d;"
    },
    "bin": [
        "php.exe",
        "php-cgi.exe"
    ],
    "persist": "conf.d",
    "checkver": {
        "url": "https://www.php.net/releases/branches.php",
        "jsonpath": "$.[?(@.branch == '8.6')].latest"
    },
    "autoupdate": {
        "architecture": {
            "32bit": {
                "url": "https://downloads.php.net/~windows/releases/archives/php-$version-nts-Win32-vs18-x86.zip"
            },
            "64bit": {
                "url": "https://downloads.php.net/~windows/releases/archives/php-$version-nts-Win32-vs18-x64.zip"
            }
        },
        "hash": {
            "url": "https://downloads.php.net/~windows/releases/releases.json",
            "jsonpath": "$..[?(@.path == '$basename')].sha256"
        }
    }
}
